* text=auto
*.rs text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.ps1 text eol=lf
*.css text eol=lf
*.wgsl text eol=lf

# Preserve the exact upstream bytes recorded in licenses/dxc/sources.json.
/licenses/dxc/mach-LICENSE* -text
/licenses/dxc/compiler-* -text
# Preserve upstream license formatting, including its final blank line.
/vendor/zgui-render-wgpu/LICENSE whitespace=-blank-at-eof
